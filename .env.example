# ── Local development (docker-compose) ──
POSTGRES_DB=stellarhex
POSTGRES_USER=stellarhex
POSTGRES_PASSWORD=changeme
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_CLIENT_SECRET=changeme

# ── Railway production ──
# App service env vars (use Railway variable references where possible):
#   SPRING_PROFILES_ACTIVE=prod
#   PORT=8080
#   DB_HOST=${{Postgres.PGHOST}}
#   DB_PORT=${{Postgres.PGPORT}}
#   DB_NAME=${{Postgres.PGDATABASE}}
#   DB_USER=${{Postgres.PGUSER}}
#   DB_PASS=${{Postgres.PGPASSWORD}}
#   KEYCLOAK_CLIENT_SECRET=<your-secret>
#   KEYCLOAK_AUTH_URI=https://<keycloak-domain>/realms/stellar-hex/protocol/openid-connect/auth
#   KEYCLOAK_INTERNAL_TOKEN_URI=http://keycloak.railway.internal:8080/realms/stellar-hex/protocol/openid-connect/token
#   KEYCLOAK_INTERNAL_USERINFO_URI=http://keycloak.railway.internal:8080/realms/stellar-hex/protocol/openid-connect/userinfo
#   KEYCLOAK_INTERNAL_JWKS_URI=http://keycloak.railway.internal:8080/realms/stellar-hex/protocol/openid-connect/certs
#   FRONTEND_URL=https://<app-domain>.up.railway.app
#   KEYCLOAK_LOGOUT_URL=https://<keycloak-domain>/realms/stellar-hex/protocol/openid-connect/logout
#
# Keycloak service env vars:
#   KC_DB=postgres
#   KC_DB_URL=jdbc:postgresql://${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/${{Postgres.PGDATABASE}}
#   KC_DB_USERNAME=${{Postgres.PGUSER}}
#   KC_DB_PASSWORD=${{Postgres.PGPASSWORD}}
#   KC_HOSTNAME=https://<keycloak-domain>.up.railway.app
#   KC_PROXY_HEADERS=xforwarded
#   KC_HTTP_ENABLED=true
#   KC_HTTP_PORT=8080
#   KC_BOOTSTRAP_ADMIN_USERNAME=admin
#   KC_BOOTSTRAP_ADMIN_PASSWORD=<your-admin-password>
